# =====================================================
# ENVIRONMENT VARIABLES — Men's World Kenya
# =====================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git — it contains secrets!
#
# WHERE TO GET EACH VALUE:
# -------------------------
# SUPABASE: Go to supabase.com → New Project → Settings → API
# WHATSAPP: Sign up at business.whatsapp.com → Cloud API → get token & phone ID
# MPESA:    Go to developer.safaricom.co.ke → Create App → get keys

# --- SUPABASE (Database + Auth + Storage) ---
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- WHATSAPP BUSINESS API (Order Notifications to Owner) ---
WHATSAPP_API_TOKEN=your_whatsapp_cloud_api_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
OWNER_WHATSAPP_NUMBER=254716057611  # Owner's number (no + prefix)

# --- M-PESA DARAJA API (Payments) ---
MPESA_CONSUMER_KEY=your_mpesa_consumer_key_here
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret_here
MPESA_BUSINESS_SHORT_CODE=your_business_shortcode_here
MPESA_PASSKEY=your_mpesa_passkey_here
MPESA_CALLBACK_URL=https://your-vercel-domain.vercel.app/api/mpesa/callback

# --- SITE ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Men's World Kenya
